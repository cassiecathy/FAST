%AXGEndBitmap
GR
GR
GS
[0.24 0 0 0.24 240.00002 67.24] CT
[1 0 0 1 0 0] CT
N
-1000 -281 M
1500 -281 L
1500 1124 L
-1000 1124 L
-1000 -281 L
cp
clip
GS
0 0 translate
1000 562 scale
%AXGBeginBitmap: java.awt.image.BufferedImage
{{
/RawData currentfile /ASCII85Decode filter def
/Data RawData /FlateDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 562
  /ImageMatrix [1000 0 0 562 0 0]
  /Width 1000
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec
